{
    "semi": true,
    "tabWidth": 2,
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "avoid",
    "proseWrap": "preserve",
    "quoteProps": "as-needed",
    "useTabs": false,
    "endOfLine": "lf",
    "embeddedLanguageFormatting": "auto",
    "jsxSingleQuote": false
}